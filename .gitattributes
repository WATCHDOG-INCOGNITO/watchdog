# Default: let Git auto-detect text vs binary, normalize line endings on commit.
* text=auto

# Shell scripts MUST be LF — they run inside Linux containers and CRLF breaks
# the shebang (`exec /startup.sh: no such file or directory`).
*.sh        text eol=lf
*.bash      text eol=lf

# Dockerfiles & compose YAML run in Linux build context.
Dockerfile  text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Python entry points executed inside containers — keep LF for safety.
*.py        text eol=lf

# Web assets that get served as-is.
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf

# Windows-only scripts.
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Common binaries — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.7z        binary
*.woff      binary
*.woff2     binary
