# Watchdog 환경변수 예시 — 이 파일을 .env로 복사해서 키를 채워 사용.

# ── LLM ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voyage AI 임베딩 (Knowledge RAG / retrieve_similar_patterns) ──
# .env 또는 secrets/voyage.key (한 줄 파일) 둘 중 하나에 박음.
# 둘 다 있으면 .env 우선. backend entrypoint 가 file을 자동 read해 export.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_DIM=1024

# ── 에이전트 모드 ──────────────────────────────────────
# multi  : Planner → ScanExecutor → Verifier → Reporter (기본)
# single : 단일 루프 (legacy, 하네스 비교 baseline용)
WATCHDOG_AGENT_MODE=multi

# ── DB ────────────────────────────────────────────────
DB_NAME=bugbounty_agent
DB_USER=bugbounty
DB_PASSWORD=bugbounty123
DB_HOST=db
DB_PORT=5432

# ── GCS (KB sync + evidence upload) ──────────────────
# default: GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json + watchdog-evidence
# 다른 bucket/key 쓸 때만 override.
# 자세한 secrets 관리는 secrets/README.md 참고.
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=
